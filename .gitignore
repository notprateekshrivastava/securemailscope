__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.env
models/*.joblib
# Regenerated by python -m app.ml.train. model_metadata.json IS committed on purpose:
# it is the record of how the model was trained and how well it generalised.
models/training_dataset.csv
data/uploads/*
data/analyses/*
data/sample-results/*
!data/uploads/.gitkeep
!data/analyses/.gitkeep

# Lab toolkit artefacts
samples/lab/certs/*.key.pem
samples/lab/capture_log.json

# Generated analysis output. data/batch/ holds per-session rows extracted from the
# captures you analysed - if any of those came from the organisation, committing this
# folder would publish their traffic. The .gitkeep files stay.
data/batch/*
data/analyses/*
!data/batch/.gitkeep
!data/analyses/.gitkeep

# Generated reports and dataset releases
reports/
dist/

# Third-party captures. These are useful locally but they are not ours to publish:
#   The-Ultimate-PCAP.pcapng            weberblog.net
#   imap-ssl / pop-ssl / smtp-ssl       github.com/Lekensteyn/wireshark-notes
# Only samples/lab/** was generated by this project and may be committed.
samples/The-Ultimate-PCAP.pcapng
samples/The-Ultimate-PCAP.pcapng.gz
samples/imap-ssl.pcapng
samples/pop-ssl.pcapng
samples/smtp-ssl.pcapng
samples/external/
